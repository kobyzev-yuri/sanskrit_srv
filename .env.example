# Copy to server as /opt/sanskrit_srv/.env via scp — never commit real values.
DATABASE_URL=sqlite:////opt/sanskrit_srv/data/sanskrit_srv.db
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_ROOT=/opt/sanskrit_srv/storage
CORS_ORIGINS=*

# ProxyAPI (one key for OpenAI + Gemini gateways)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_BASE_URL=https://api.proxyapi.ru/google
GEMINI_MODEL=gemini-2.5-flash

# Large PDFs (MantraPushpam ≈623 pp.): default extract window
DEFAULT_EXTRACT_MAX_PAGES=20

# Скопировать в .env при старте реализации
DATABASE_URL=postgresql+psycopg://sanskrit:sanskrit@localhost:5433/sanskrit_srv
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me
STORAGE_ROOT=./storage

# ProxyAPI (как в ../scinikel/config.env)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_BASE_URL=https://api.proxyapi.ru/google
GEMINI_MODEL=gemini-2.5-flash

# Путь к существующему пайплайну (seed / reuse)
INFANT_READER_OCR_ROOT=../infant_reader_ocr

# Copy to .env (local) or /opt/sanskrit_srv/.env (VPS). Never commit real values.

DATABASE_URL=sqlite:///./data/sanskrit_srv.db
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_ROOT=./storage
CORS_ORIGINS=*

# Google AI Studio — default vision/chat (digitize + translate + proofread)
GEMINI_API_KEY=
# Extra Studio keys (comma): label:key. Each free key has ~20 requests/day; exhausted keys are skipped.
# GEMINI_API_KEYS=sanskrit_srv_1:,sanskrit_srv_2:
# Optional labeled file on the server (same format as the local keys dump). Not in git.
# GEMINI_KEYS_FILE=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.1-pro-preview

# OpenRouter — optional (ox-alpha is no longer in the live catalog)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_HTTP_REFERER=https://sanskrit-srv.local
OPENROUTER_APP_TITLE=sanskrit_srv
OPENROUTER_MAX_TOKENS=16384

# Haimaker GLM-5V Turbo — multimodal test (scans). glm-5.3 is text-only and rejects images.
HAIMAKER_API_KEY=
HAIMAKER_BASE_URL=https://api.haimaker.ai/v1
HAIMAKER_MODEL=z-ai/glm-5v-turbo

# ProxyAPI — Claude Opus / OpenAI fallback (admin route "opus")
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini
# Claude (ProxyAPI). Do NOT put claude-* into GEMINI_MODEL.
ANTHROPIC_BASE_URL=https://api.proxyapi.ru/anthropic
ANTHROPIC_MODEL=claude-opus-5

# Auto whole-book LLM only if PDF has this many pages or fewer (else page-by-page)
LARGE_BOOK_PAGES=10

# Consecutive scan pages in one digitize LLM call (ceiling; Flash 3 / Pro 6 / Opus 4 / GLM 1; max 8).
# Flash often truncates a 6-page HTML dump — keep the ceiling, the route picks a smaller n.
DIGITIZE_BATCH_PAGES=6
# Consecutive translation pages in one text LLM call (ceiling; Flash 3 / Pro 6 / Opus 4 / GLM-ox 2).
TRANSLATE_BATCH_PAGES=6

# Legacy (unused for whole-book upload); keep 0
DEFAULT_EXTRACT_MAX_PAGES=0

# Optional USD estimate in UI (per 1M tokens). Key = network:model
# LLM_PRICE_PER_1M={"gemini:gemini-2.5-flash":{"in":0.1,"out":0.4},"openai:gpt-4o-mini":{"in":0.15,"out":0.6}}
